datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  offers    Offer[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum MarketplaceType {
  SHOPEE
  MERCADO_LIVRE
}

model Marketplace {
  id        String          @id @default(uuid())
  name      String
  type      MarketplaceType @unique
  offers    Offer[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  offers      Offer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OfferStatus {
  ACTIVE
  PAUSED
}

enum EvaluationDecision {
  ELIGIBLE
  REJECTED_LOW_SCORE
  REJECTED_FATIGUE
  REJECTED_DUPLICATE
  REJECTED_INSUFFICIENT_DATA
  ERROR
}

enum PublicationCandidateStatus {
  PENDING
  QUEUED
  PUBLISHING
  PUBLISHED
  SKIPPED
  FAILED
}

model Offer {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  marketplaceId String
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  externalId    String
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])

  title      String @default("")
  price      Int
  commission Int
  url        String

  status OfferStatus   @default(ACTIVE)
  links  TrackedLink[]

  observations   OfferObservation[]
  evaluations    OfferEvaluation[]
  priceHistories PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, marketplaceId, externalId])
}

model OfferObservation {
  id               String @id @default(uuid())
  offerId          String
  offer            Offer  @relation(fields: [offerId], references: [id])
  correlationId    String @unique
  schemaVersion    String
  canonicalPayload Json

  evaluations OfferEvaluation[]

  observedAt DateTime
  createdAt  DateTime @default(now())
}

model OfferEvaluation {
  id            String           @id @default(uuid())
  offerId       String
  offer         Offer            @relation(fields: [offerId], references: [id])
  observationId String
  observation   OfferObservation @relation(fields: [observationId], references: [id])

  scoreVersion    String
  score           Decimal
  decision        EvaluationDecision
  decisionReasons String[]

  scoreBreakdown Json
  inputsSnapshot Json

  candidate PublicationCandidate?

  evaluatedAt DateTime @default(now())

  @@index([offerId])
  @@index([decision, evaluatedAt])
}

model PublicationCandidate {
  id           String          @id @default(uuid())
  evaluationId String          @unique
  evaluation   OfferEvaluation @relation(fields: [evaluationId], references: [id])

  status PublicationCandidateStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model PriceHistory {
  id          String   @id @default(uuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id])
  priceCents  Int
  discountBps Int?
  createdAt   DateTime @default(now())

  @@index([offerId, createdAt])
}

enum LinkStatus {
  ACTIVE
  INACTIVE
}

model TrackedLink {
  id        String     @id @default(uuid())
  offerId   String
  offer     Offer      @relation(fields: [offerId], references: [id])
  slug      String     @unique
  targetUrl String
  status    LinkStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
