datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         TenantMembership[]
  approvedAdCampaigns AdCampaign[]       @relation("AdCampaignApprovedBy")
  rejectedAdCampaigns AdCampaign[]       @relation("AdCampaignRejectedBy")
  adBillingEvents     AdBillingEvent[]
  adAuditEvents       AdAuditEvent[]
}

model Tenant {
  id                      String                   @id @default(uuid())
  name                    String
  products                Product[]
  offers                  Offer[]
  channels                Channel[]
  channelIntegrations     ChannelIntegration[]
  whatsappSafetyConfig    WhatsAppSafetyConfig?
  marketplaceIntegrations MarketplaceIntegration[]
  affiliateLinks          AffiliateLink[]

  memberships          TenantMembership[]
  autopilotConfig      AutopilotConfig?
  autopilotAudits      AutopilotAudit[]
  adminAlertConfig     AdminAlertConfig?
  adminAlerts          AdminAlert[]
  adminAlertRecipients AdminAlertRecipient[]

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  marketplaceConversions     MarketplaceConversion[]
  marketplaceBrowserSessions MarketplaceBrowserSession[]
  publicationTemplates       PublicationTemplate[]
  publicTrackedLinks         PublicTrackedLink[]
  adsConfig                  AdsConfig?
  advertisers                Advertiser[]
  adCampaigns                AdCampaign[]
  adBillingEvents            AdBillingEvent[]
  adBalances                 AdvertiserBalance[]
  adAuditEvents              AdAuditEvent[]
}

enum TenantRole {
  OWNER
  ADMIN
}

model TenantMembership {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  adminUserId String
  adminUser   AdminUser  @relation(fields: [adminUserId], references: [id])
  role        TenantRole @default(ADMIN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, adminUserId])
}

enum ChannelProvider {
  TELEGRAM
  WHATSAPP
}

enum WhatsAppTransport {
  CLOUD_OFFICIAL
  WEB_UNOFFICIAL
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

model Channel {
  id                       String            @id @default(uuid())
  tenantId                 String
  tenant                   Tenant            @relation(fields: [tenantId], references: [id])
  provider                 ChannelProvider
  externalChatId           String
  displayName              String
  visibility               ChannelVisibility @default(PRIVATE)
  enabled                  Boolean           @default(true)
  safetyMaxPerHour         Int               @default(10)
  safetyMaxPerDay          Int               @default(50)
  safetyMinIntervalSeconds Int               @default(60)
  safetyWindowStartMinute  Int?
  safetyWindowEndMinute    Int?
  lastSeenAt               DateTime?
  staleAt                  DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  publications     Publication[]
  autopilotConfigs AutopilotChannelConfig[]
  autopilotAudits  AutopilotAudit[]

  @@unique([tenantId, provider, externalChatId])
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  NEEDS_REAUTH
  ERROR
}

model ChannelIntegration {
  id                   String            @id @default(uuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id])
  provider             ChannelProvider
  transport            WhatsAppTransport @default(CLOUD_OFFICIAL)
  status               IntegrationStatus @default(NOT_CONNECTED)
  externalInstanceName String?
  wabaId               String?
  phoneNumberId        String?
  businessDisplayName  String?
  encryptedAccessToken String?
  tokenIv              String?
  tokenAuthTag         String?
  connectedAt          DateTime?
  lastHealthCheckAt    DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  adminAlertConfigs AdminAlertConfig[]

  @@unique([tenantId, provider])
}

model MarketplaceIntegration {
  id                         String            @id @default(uuid())
  tenantId                   String
  tenant                     Tenant            @relation(fields: [tenantId], references: [id])
  provider                   MarketplaceType
  publicIdentifier           String? // e.g. App ID / Meli User ID
  encryptedSecret            String? // AES-256-GCM encrypted secret / Access Token
  iv                         String?
  authTag                    String?
  encryptedRefreshToken      String?
  refreshIv                  String?
  refreshAuthTag             String?
  expiresAt                  DateTime?
  keyVersion                 Int               @default(1)
  status                     IntegrationStatus @default(NOT_CONNECTED)
  lastSyncAt                 DateTime?
  lastSyncProcessedCount     Int?
  lastSyncFoundCount         Int?
  lastSyncCreatedCount       Int?
  lastSyncUpdatedCount       Int?
  lastSyncIgnoredCount       Int?
  lastConversionSyncAt       DateTime?
  lastConversionError        String?
  lastDiscoveryAt            DateTime?
  lastDiscoveryCategoryCount Int?
  lastDiscoveryFoundCount    Int?
  lastDiscoveryCreatedCount  Int?
  lastDiscoveryIgnoredCount  Int?
  lastDiscoveryError         String?
  lastError                  String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@unique([tenantId, provider])
}

enum MarketplaceBrowserSessionStatus {
  DISCONNECTED
  AUTHENTICATING
  CONNECTED
  REAUTH_REQUIRED
  CHALLENGE_REQUIRED
  ERROR
}

model MarketplaceBrowserSession {
  id                    String                          @id @default(uuid())
  tenantId              String
  tenant                Tenant                          @relation(fields: [tenantId], references: [id])
  provider              MarketplaceType
  encryptedStorageState String?
  iv                    String?
  authTag               String?
  status                MarketplaceBrowserSessionStatus @default(DISCONNECTED)
  lastAuthenticatedAt   DateTime?
  lastUsedAt            DateTime?
  lastErrorAt           DateTime?
  lastErrorSanitized    String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  @@unique([tenantId, provider])
}

enum MarketplaceType {
  SHOPEE
  MERCADO_LIVRE
}

model Marketplace {
  id               String                       @id @default(uuid())
  name             String
  type             MarketplaceType              @unique
  offers           Offer[]
  autopilotConfigs AutopilotMarketplaceConfig[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  offers      Offer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OfferStatus {
  ACTIVE
  PAUSED
}

enum EvaluationDecision {
  ELIGIBLE
  REJECTED_LOW_SCORE
  REJECTED_FATIGUE
  REJECTED_DUPLICATE
  REJECTED_INSUFFICIENT_DATA
  REJECTED_MARKETPLACE_POLICY
  ERROR
}

enum PublicationCandidateStatus {
  PENDING
  QUEUED
  PUBLISHING
  DEFERRED
  PUBLISHED
  SKIPPED
  FAILED
}

model Offer {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  marketplaceId String
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  externalId    String
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])

  title      String  @default("")
  price      Int
  commission Int?
  url        String
  imageUrl   String?

  status         OfferStatus     @default(ACTIVE)
  links          TrackedLink[]
  affiliateLinks AffiliateLink[]

  observations   OfferObservation[]
  priceHistories PriceHistory[]

  monetization MonetizationRecord?

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  marketplaceConversions MarketplaceConversion[]
  publicTrackedLinks     PublicTrackedLink[]
  adCampaigns            AdCampaign[]
  adDeliveries           AdDelivery[]

  @@unique([tenantId, marketplaceId, externalId])
}

enum PublicationTemplateType {
  ACHADINHO
  OFERTA
  PRECO_CAIU
  MAIS_VENDIDO
  GENERIC
}

enum PublicationTemplateCtaMode {
  AUTO
  CUSTOM
}

model PublicationTemplate {
  id        String                     @id @default(uuid())
  tenantId  String
  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      PublicationTemplateType
  enabled   Boolean                    @default(true)
  isDefault Boolean                    @default(false)
  body      String
  ctaMode   PublicationTemplateCtaMode @default(AUTO)
  customCta String?
  priority  Int                        @default(0)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([tenantId, enabled])
  @@index([tenantId, type])
}

enum AffiliateLinkStatus {
  UNVERIFIED
  VERIFYING
  VERIFIED
  FAILED
}

model AffiliateLink {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  offerId  String
  offer    Offer  @relation(fields: [offerId], references: [id])

  provider       String // "SHOPEE"
  attributionKey String              @unique
  context        String // e.g. "OFFER_VERIFICATION", "PUBLICATION"
  contextId      String? // Optional ID for the context (e.g. channelId)
  affiliateUrl   String?
  status         AffiliateLinkStatus @default(UNVERIFIED)

  verifiedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  marketplaceConversions MarketplaceConversion[]
  publicTrackedLinks     PublicTrackedLink[]

  @@unique([offerId, context, contextId]) // Idempotency
  @@index([offerId, status])
  @@index([tenantId, attributionKey])
}

model OfferObservation {
  id               String  @id @default(uuid())
  offerId          String
  offer            Offer   @relation(fields: [offerId], references: [id])
  correlationId    String  @unique
  schemaVersion    String
  canonicalPayload Json
  category         String?
  discoverySource  String?
  sourceCategoryId String?
  rankingPosition  Int?
  sourceEntityType String?

  evaluations  OfferEvaluation[]
  priceHistory PriceHistory?

  observedAt DateTime
  createdAt  DateTime @default(now())
}

model OfferEvaluation {
  id            String           @id @default(uuid())
  observationId String
  observation   OfferObservation @relation(fields: [observationId], references: [id])

  scoreVersion    String
  score           Decimal?
  decision        EvaluationDecision
  decisionReasons String[]

  scoreBreakdown Json
  inputsSnapshot Json

  candidate PublicationCandidate?

  evaluatedAt DateTime @default(now())

  autopilotAudits AutopilotAudit[]

  @@unique([observationId, scoreVersion])
  @@index([decision, evaluatedAt])
}

model PublicationCandidate {
  id           String          @id @default(uuid())
  evaluationId String          @unique
  evaluation   OfferEvaluation @relation(fields: [evaluationId], references: [id])

  status         PublicationCandidateStatus @default(PENDING)
  deferredReason String?
  retryAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publications    Publication[]
  autopilotAudits AutopilotAudit[]

  @@index([status, createdAt])
}

enum PublicationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  WAITING_CONNECTION
  RETRYABLE
  DELIVERY_UNKNOWN
  FAILED
}

model Publication {
  id                String               @id @default(uuid())
  candidateId       String
  candidate         PublicationCandidate @relation(fields: [candidateId], references: [id])
  channelId         String
  channel           Channel              @relation(fields: [channelId], references: [id])
  status            PublicationStatus    @default(PENDING)
  externalMessageId String?
  publishedAt       DateTime?
  errorReason       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  trackedLink    TrackedLink?
  deliveryEvents PublicationDeliveryEvent[]

  @@unique([candidateId, channelId])
}

enum PublicationDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model PublicationDeliveryEvent {
  id                    String                    @id @default(uuid())
  publicationId         String
  publication           Publication               @relation(fields: [publicationId], references: [id])
  provider              ChannelProvider
  externalMessageId     String
  status                PublicationDeliveryStatus
  occurredAt            DateTime?
  receivedAt            DateTime                  @default(now())
  errorCode             String?
  errorMessageSanitized String?

  @@unique([externalMessageId, status])
  @@index([publicationId, status])
}

model PriceHistory {
  id                 String            @id @default(uuid())
  offerId            String
  offer              Offer             @relation(fields: [offerId], references: [id])
  observationId      String?           @unique
  observation        OfferObservation? @relation(fields: [observationId], references: [id])
  priceCents         Int
  originalPriceCents Int?
  discountBps        Int?
  commissionCents    Int?
  salesCount         Int?
  rating             Float?
  observedAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())

  @@index([offerId, createdAt])
  @@index([offerId, observedAt])
}

enum WhatsAppCircuitState {
  CLOSED
  OPEN
}

model WhatsAppSafetyConfig {
  id                          String               @id @default(uuid())
  tenantId                    String               @unique
  tenant                      Tenant               @relation(fields: [tenantId], references: [id])
  enabled                     Boolean              @default(true)
  killSwitch                  Boolean              @default(false)
  minIntervalSeconds          Int                  @default(60)
  maxPerHour                  Int                  @default(20)
  maxPerDay                   Int                  @default(100)
  quietStartMinute            Int?
  quietEndMinute              Int?
  reconnectionCooldownSeconds Int                  @default(90)
  minQualityScore             Float                @default(0)
  maxObservationAgeMinutes    Int                  @default(1440)
  circuitState                WhatsAppCircuitState @default(CLOSED)
  consecutiveErrors           Int                  @default(0)
  circuitOpenedAt             DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
}

model TrackedLink {
  id             String      @id @default(uuid())
  publicationId  String      @unique
  publication    Publication @relation(fields: [publicationId], references: [id])
  offerId        String
  offer          Offer       @relation(fields: [offerId], references: [id])
  slug           String      @unique
  destinationUrl String
  active         Boolean     @default(true)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  clicks ClickEvent[]
}

model PublicTrackedLink {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerId         String
  offer           Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  affiliateLinkId String?
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  token           String         @unique
  source          String         @default("PUBLIC_SEARCH")
  destinationUrl  String
  active          Boolean        @default(true)
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  clicks PublicClickEvent[]

  @@index([tenantId, offerId])
  @@index([affiliateLinkId])
}

model PublicClickEvent {
  id                   String                  @id @default(uuid())
  eventId              String                  @unique
  linkId               String
  link                 PublicTrackedLink       @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt            DateTime                @default(now())
  classification       ClickClassification     @default(VALID)
  classificationReason String?
  intelligenceClass    ClickIntelligenceClass?
  visitorHash          String?
  userAgentFamily      String?
  operatingSystem      String?
  deviceType           String?
  referrer             String?

  @@index([linkId, clickedAt])
  @@index([classification, clickedAt])
}

enum ClickClassification {
  VALID
  PREVIEW_BOT
  SUSPECTED_BOT
}

enum ClickIntelligenceClass {
  HUMAN
  BOT
  PREVIEW_CRAWLER
  SUSPECTED_AUTOMATION
}

model ClickEvent {
  id                   String                  @id @default(uuid())
  eventId              String                  @unique
  linkId               String
  link                 TrackedLink             @relation(fields: [linkId], references: [id])
  clickedAt            DateTime                @default(now())
  classification       ClickClassification     @default(VALID)
  classificationReason String?
  intelligenceClass    ClickIntelligenceClass?
  visitorHash          String?
  userAgentFamily      String?
  operatingSystem      String?
  deviceType           String?
  referrer             String?

  @@index([linkId, clickedAt])
  @@index([classification, clickedAt])
  @@index([intelligenceClass, clickedAt])
}

enum AdsAdvertiserStatus {
  ACTIVE
  SUSPENDED
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

enum AdMarketplace {
  SHOPEE
}

enum AdPlacement {
  PUBLIC_SEARCH
}

enum AdPricingModel {
  CPC
}

enum AdBillingEventType {
  CREDIT
  CHARGE
  RESERVE
  RELEASE
  REFUND
  REVERSAL
  ADJUSTMENT
}

enum AdBillingDirection {
  POSITIVE
  NEGATIVE
}

enum AdAuditAction {
  ADVERTISER_CREATED
  ADVERTISER_UPDATED
  ADVERTISER_SUSPENDED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_SUBMITTED
  CAMPAIGN_APPROVED
  CAMPAIGN_REJECTED
  CAMPAIGN_PAUSED
  CAMPAIGN_RESUMED
  CREDIT_ADDED
}

enum AdClickStatus {
  RAW
  VALIDATED
  BILLABLE
  NON_BILLABLE
  REVERSED
}

model AdsConfig {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsEnabled             Boolean  @default(false)
  adsPublicSearchEnabled Boolean  @default(false)
  adsBillingEnabled      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Advertiser {
  id           String              @id @default(uuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  companyName  String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  status       AdsAdvertiserStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  campaigns     AdCampaign[]
  balance       AdvertiserBalance?
  billingEvents AdBillingEvent[]
  auditEvents   AdAuditEvent[]

  @@index([tenantId, status])
}

model AdCampaign {
  id                    String           @id @default(uuid())
  tenantId              String
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  advertiserId          String
  advertiser            Advertiser       @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  name                  String
  status                AdCampaignStatus @default(DRAFT)
  marketplace           AdMarketplace    @default(SHOPEE)
  placement             AdPlacement      @default(PUBLIC_SEARCH)
  offerId               String
  offer                 Offer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  pricingModel          AdPricingModel   @default(CPC)
  bidCpcCents           Int
  totalBudgetCents      Int
  dailyBudgetCents      Int
  startAt               DateTime
  endAt                 DateTime
  submittedAt           DateTime?
  approvedAt            DateTime?
  approvedByAdminUserId String?
  approvedByAdminUser   AdminUser?       @relation("AdCampaignApprovedBy", fields: [approvedByAdminUserId], references: [id], onDelete: SetNull)
  rejectedAt            DateTime?
  rejectedByAdminUserId String?
  rejectedByAdminUser   AdminUser?       @relation("AdCampaignRejectedBy", fields: [rejectedByAdminUserId], references: [id], onDelete: SetNull)
  rejectionReason       String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  deliveries    AdDelivery[]
  clicks        AdClick[]
  billingEvents AdBillingEvent[]
  auditEvents   AdAuditEvent[]

  @@index([tenantId, status])
  @@index([advertiserId, status])
  @@index([offerId])
}

model AdDelivery {
  id                  String      @id @default(uuid())
  tenantId            String
  campaignId          String
  campaign            AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  offerId             String
  offer               Offer       @relation(fields: [offerId], references: [id], onDelete: Restrict)
  placement           AdPlacement @default(PUBLIC_SEARCH)
  publicTrackedLinkId String?
  idempotencyKey      String      @unique
  createdAt           DateTime    @default(now())

  clicks AdClick[]

  @@index([tenantId, campaignId, createdAt])
}

model AdClick {
  id                 String        @id @default(uuid())
  tenantId           String
  campaignId         String
  campaign           AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliveryId         String?
  delivery           AdDelivery?   @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  publicClickEventId String?       @unique
  eventId            String        @unique
  status             AdClickStatus @default(RAW)
  reason             String?
  visitorKey         String?
  createdAt          DateTime      @default(now())
  validatedAt        DateTime?
  billableAt         DateTime?

  billingEvents AdBillingEvent[]

  @@index([tenantId, campaignId, createdAt])
  @@index([status, createdAt])
}

model AdBillingEvent {
  id             String              @id @default(uuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  advertiserId   String
  advertiser     Advertiser          @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  campaignId     String?
  campaign       AdCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adClickId      String?
  adClick        AdClick?            @relation(fields: [adClickId], references: [id], onDelete: SetNull)
  type           AdBillingEventType
  direction      AdBillingDirection?
  amountCents    Int
  currency       String              @default("BRL")
  idempotencyKey String              @unique
  adminUserId    String?
  adminUser      AdminUser?          @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  reason         String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([tenantId, createdAt])
  @@index([advertiserId, createdAt])
  @@index([campaignId, createdAt])
}

model AdvertiserBalance {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  advertiserId   String     @unique
  advertiser     Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  availableCents Int        @default(0)
  reservedCents  Int        @default(0)
  version        Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId])
}

model AdAuditEvent {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  advertiserId  String?
  advertiser    Advertiser?   @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      AdCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adminUserId   String
  adminUser     AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  action        AdAuditAction
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId, createdAt])
}

enum AutopilotMode {
  OFF
  MANUAL
  DRY_RUN
  AUTO
}

model AutopilotConfig {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  mode AutopilotMode @default(OFF)

  // Time represents minutes from 00:00 (0..1439)
  allowedStartMinute Int    @default(540) // 09:00
  allowedEndMinute   Int    @default(1200) // 20:00
  timezone           String @default("America/Campo_Grande")

  minScore               Decimal   @default(70)
  minimumCommissionCents Int       @default(500)
  maxDailyPosts          Int       @default(30)
  intervalMinutes        Int       @default(30)
  minSendIntervalMinutes Int?
  maxSendIntervalMinutes Int?
  nextEligibleSendAt     DateTime?
  sendLeaseUntil         DateTime?

  enabledChannels     AutopilotChannelConfig[]
  enabledMarketplaces AutopilotMarketplaceConfig[]
  catalogPolicy       AutopilotCatalogPolicy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AutopilotCatalogMode {
  OPEN
  SELECTED_CATEGORIES
}

model AutopilotCatalogPolicy {
  id                   String               @id @default(uuid())
  autopilotConfigId    String               @unique
  autopilotConfig      AutopilotConfig      @relation(fields: [autopilotConfigId], references: [id], onDelete: Cascade)
  mode                 AutopilotCatalogMode @default(OPEN)
  allowedCategories    String[]             @default([])
  blockedCategories    String[]             @default([])
  blockedKeywords      String[]             @default([])
  minSalesCount        Int?
  minRating            Float?
  productCooldownHours Int?
  maxPerCategoryPerDay Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model AutopilotChannelConfig {
  id                String          @id @default(uuid())
  autopilotConfigId String
  config            AutopilotConfig @relation(fields: [autopilotConfigId], references: [id])
  channelId         String
  channel           Channel         @relation(fields: [channelId], references: [id])

  @@unique([autopilotConfigId, channelId])
}

model AutopilotMarketplaceConfig {
  id                String          @id @default(uuid())
  autopilotConfigId String
  config            AutopilotConfig @relation(fields: [autopilotConfigId], references: [id])
  marketplaceId     String
  marketplace       Marketplace     @relation(fields: [marketplaceId], references: [id])

  @@unique([autopilotConfigId, marketplaceId])
}

enum AutopilotDecisionReason {
  APPROVED
  REJECTED_LOW_SCORE
  REJECTED_DAILY_LIMIT
  REJECTED_INTERVAL
  REJECTED_OUTSIDE_SCHEDULE
  REJECTED_FATIGUE
  REJECTED_DUPLICATE
  REJECTED_MONETIZATION
  REJECTED_MINIMUM_COMMISSION
  REJECTED_CHANNEL_POLICY
  REJECTED_KILL_SWITCH
  REJECTED_INTEGRATION_UNHEALTHY
  REJECTED_CATEGORY
  REJECTED_BLOCKED_CATEGORY
  REJECTED_BLOCKED_KEYWORD
  REJECTED_MIN_SALES
  REJECTED_MIN_RATING
  REJECTED_PRODUCT_COOLDOWN
  REJECTED_CATEGORY_DAILY_LIMIT
  DRY_RUN_APPROVED
  DEFERRED_DAILY_LIMIT
  DEFERRED_INTERVAL
  DEFERRED_OUTSIDE_SCHEDULE
  DEFERRED_INTEGRATION_UNHEALTHY
  DEFERRED_MONETIZATION
  SKIPPED_PERMANENT_POLICY
  DELIVERY_UNKNOWN
}

model AutopilotAudit {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  candidateId String
  candidate   PublicationCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  evaluationId String
  evaluation   OfferEvaluation @relation(fields: [evaluationId], references: [id])

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id])

  decision AutopilotDecisionReason
  liaScore Decimal

  details Json? // For extra info, e.g. "iPhone 16 aprovado no Dry Run"

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum MonetizationStatus {
  UNAVAILABLE
  UNVERIFIED
  VERIFIED
}

model MonetizationRecord {
  id      String @id @default(uuid())
  offerId String @unique
  offer   Offer  @relation(fields: [offerId], references: [id])

  status MonetizationStatus @default(UNVERIFIED)

  provider              String // Affiliate network or marketplace
  destinationUrl        String?
  commissionAmountCents Int?
  commissionRateBps     Int?

  source        String // e.g. "shopee_open_api", "awin"
  integrationId String? // If tied to a specific integration

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AttributionStatus {
  ATTRIBUTED
  UNATTRIBUTED
}

enum ConversionCommissionStatus {
  ESTIMATED
  PENDING
  CONFIRMED
  CANCELLED
}

enum ConversionOrderStatus {
  UNPAID
  PENDING
  COMPLETED
  CANCELLED
}

model MarketplaceConversion {
  id       String          @id @default(uuid())
  tenantId String
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  provider MarketplaceType // Reusing MarketplaceType (e.g. SHOPEE)

  externalConversionId String

  purchaseTime DateTime
  clickTime    DateTime?

  utmContent        String?
  attributionKey    String?
  attributionStatus AttributionStatus          @default(UNATTRIBUTED)
  commissionStatus  ConversionCommissionStatus @default(PENDING)

  affiliateLinkId String?
  affiliateLink   AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  offerId         String?
  offer           Offer?         @relation(fields: [offerId], references: [id])

  buyerType    String?
  device       String?
  campaignType String?

  shopeeCommissionCappedCents Int?
  sellerCommissionCents       Int?
  totalCommissionCents        Int?
  netCommissionCents          Int?

  orders MarketplaceConversionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminAlerts AdminAlert[]

  @@unique([tenantId, provider, externalConversionId])
  @@index([tenantId, attributionStatus, purchaseTime])
}

model MarketplaceConversionOrder {
  id           String                @id @default(uuid())
  conversionId String
  conversion   MarketplaceConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  externalOrderId String
  orderStatus     ConversionOrderStatus
  shopType        String?

  items MarketplaceConversionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversionId, externalOrderId])
}

model MarketplaceConversionItem {
  id      String                     @id @default(uuid())
  orderId String
  order   MarketplaceConversionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  externalItemId  String
  externalLineKey String // Deterministic key to prevent duplicates: `${externalOrderId}-${externalItemId}-${qty}-${price}` or similar

  itemName          String
  qty               Int
  itemPriceCents    Int
  actualAmountCents Int

  itemTotalCommissionCents        Int?
  itemSellerCommissionCents       Int?
  itemSellerCommissionRateBps     Int?
  itemShopeeCommissionCappedCents Int?
  itemShopeeCommissionRateBps     Int?

  displayItemStatus String?
  fraudStatus       String?

  globalCategoryLv1Name String?
  globalCategoryLv2Name String?
  globalCategoryLv3Name String?
  modelId               String?
  promotionId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, externalLineKey])
}

enum AdminAlertType {
  NEW_SHOPEE_SALE
  COMMISSION_CONFIRMED
  SALE_CANCELLED
  HIGH_VALUE_SALE
  CRITICAL_ERROR
  DAILY_SUMMARY
}

enum AdminAlertDeliveryStatus {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED
}

model AdminAlert {
  id                      String                   @id @default(uuid())
  tenantId                String
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  type                    AdminAlertType
  provider                MarketplaceType?
  externalEventId         String?
  marketplaceConversionId String?
  marketplaceConversion   MarketplaceConversion?   @relation(fields: [marketplaceConversionId], references: [id], onDelete: SetNull)
  dedupeKey               String                   @unique
  payload                 Json
  deliveryStatus          AdminAlertDeliveryStatus @default(NOT_REQUESTED)
  deliveryAttempts        Int                      @default(0)
  lastDeliveryError       String?
  sentAt                  DateTime?
  readAt                  DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  deliveries AdminAlertDelivery[]

  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
}

model AdminAlertConfig {
  id                         String              @id @default(uuid())
  tenantId                   String              @unique
  tenant                     Tenant              @relation(fields: [tenantId], references: [id])
  adminWhatsappIntegrationId String?
  adminWhatsappIntegration   ChannelIntegration? @relation(fields: [adminWhatsappIntegrationId], references: [id], onDelete: SetNull)
  enabled                    Boolean             @default(false)
  encryptedRecipient         String?
  recipientIv                String?
  recipientAuthTag           String?
  keyVersion                 Int                 @default(1)
  newShopeeSaleEnabled       Boolean             @default(true)
  commissionConfirmedEnabled Boolean             @default(false)
  saleCancelledEnabled       Boolean             @default(false)
  highValueSaleEnabled       Boolean             @default(false)
  criticalErrorEnabled       Boolean             @default(false)
  dailySummaryEnabled        Boolean             @default(false)
  enabledAt                  DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  recipients AdminAlertRecipient[]
}

model AdminAlertRecipient {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configId           String
  config             AdminAlertConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  encryptedRecipient String
  recipientIv        String
  recipientAuthTag   String
  recipientHash      String
  enabled            Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  deliveries AdminAlertDelivery[]

  @@unique([configId, recipientHash])
  @@index([tenantId, enabled])
}

model AdminAlertDelivery {
  id          String                   @id @default(uuid())
  alertId     String
  alert       AdminAlert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   AdminAlertRecipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  status      AdminAlertDeliveryStatus @default(PENDING)
  attempts    Int                      @default(0)
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([alertId, recipientId])
  @@index([recipientId, status])
}
