{
  "name": "lia-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run start:dev -w @lia/worker\" \"npm run dev -w @lia/tracker\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "telegram:setup": "ts-node scripts/telegram-setup.ts",
    "meli:login": "ts-node apps/meli-rpa/src/scripts/meli-login.ts",
    "meli:inspect": "ts-node apps/meli-rpa/src/scripts/meli-inspect.ts",
    "meli:test-link": "ts-node apps/meli-rpa/src/scripts/meli-generate-test.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "concurrently": "^10.0.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "pg": "^8.22.0"
  }
}
