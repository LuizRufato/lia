FROM node:24-alpine AS evolution-builder

RUN apk update && \
    apk add --no-cache git ffmpeg wget curl bash openssl

WORKDIR /evolution

ARG EVOLUTION_UPSTREAM_REPO=https://github.com/evolution-foundation/evolution-api.git
ARG EVOLUTION_UPSTREAM_COMMIT=cd800f2976e1e5b682fbf86a01ee4d85ae61f370

RUN git init . && \
    git remote add origin "${EVOLUTION_UPSTREAM_REPO}" && \
    git fetch --depth=1 origin "${EVOLUTION_UPSTREAM_COMMIT}" && \
    git checkout --detach "${EVOLUTION_UPSTREAM_COMMIT}" && \
    test "$(git rev-parse HEAD)" = "${EVOLUTION_UPSTREAM_COMMIT}"

COPY vendor/evolution/patches/2.3.7-preview-required.patch /tmp/2.3.7-preview-required.patch

RUN git apply --unidiff-zero --check /tmp/2.3.7-preview-required.patch && \
    git apply --unidiff-zero /tmp/2.3.7-preview-required.patch && \
    node -e "const v=require('./package.json').version; if(v!=='2.3.7'){console.error('Unexpected Evolution version: '+v); process.exit(1)}"

# The upstream lockfile pins RC9. Update only that dependency before the
# official install/build so the compiler and runtime artifacts use RC13.
RUN npm install --package-lock-only --ignore-scripts --no-audit --no-fund \
      --legacy-peer-deps --save-exact baileys@7.0.0-rc13 && \
    npm ci --silent --ignore-scripts --no-audit --no-fund --legacy-peer-deps && \
    node -e "const fs=require('fs'); for (const [name,expected] of [['baileys','7.0.0-rc13'],['whatsapp-rust-bridge','0.5.4']]) { const file='/evolution/node_modules/'+name+'/package.json'; const version=JSON.parse(fs.readFileSync(file,'utf8')).version; if(version!==expected) throw new Error(name+' resolved to '+version); console.log(name+'@'+version); }"

RUN cp .env.example .env && \
    chmod +x ./Docker/scripts/* && \
    ./Docker/scripts/generate_database.sh && \
    npm run build

FROM node:24-alpine AS evolution-runtime

RUN apk update && \
    apk add --no-cache tzdata ffmpeg bash openssl

ENV TZ=America/Sao_Paulo
ENV DOCKER_ENV=true

WORKDIR /evolution

COPY --from=evolution-builder /evolution/package.json ./package.json
COPY --from=evolution-builder /evolution/package-lock.json ./package-lock.json
COPY --from=evolution-builder /evolution/node_modules ./node_modules
COPY --from=evolution-builder /evolution/dist ./dist
COPY --from=evolution-builder /evolution/prisma ./prisma
COPY --from=evolution-builder /evolution/manager ./manager
COPY --from=evolution-builder /evolution/public ./public
COPY --from=evolution-builder /evolution/.env ./.env
COPY --from=evolution-builder /evolution/Docker ./Docker
COPY --from=evolution-builder /evolution/runWithProvider.js ./runWithProvider.js
COPY --from=evolution-builder /evolution/tsup.config.ts ./tsup.config.ts

EXPOSE 8080

ENTRYPOINT ["/bin/bash", "-c", ". ./Docker/scripts/deploy_database.sh && npm run start:prod"]
