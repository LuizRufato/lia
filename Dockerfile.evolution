FROM evoapicloud/evolution-api:v2.3.7

USER root
WORKDIR /evolution

# Keep Evolution pinned at 2.3.7 while replacing only the known delivery fix.
RUN npm install --no-save --package-lock=false --legacy-peer-deps \
      baileys@7.0.0-rc13 \
      whatsapp-rust-bridge@0.5.4 \
    && node -e "const fs=require('fs'); for (const [name,expected] of [['baileys','7.0.0-rc13'],['whatsapp-rust-bridge','0.5.4']]) { const file='/evolution/node_modules/'+name+'/package.json'; if (!fs.existsSync(file)) throw new Error('package metadata not found: '+name); const version=JSON.parse(fs.readFileSync(file,'utf8')).version; if (version!==expected) throw new Error(name+' resolved to '+version); console.log(name+'@'+version); }"
