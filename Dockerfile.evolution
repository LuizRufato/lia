FROM evoapicloud/evolution-api:v2.3.7

USER root
WORKDIR /evolution

# Keep Evolution pinned at 2.3.7 while replacing only the known delivery fix.
RUN npm install --no-save --package-lock=false --legacy-peer-deps \
      baileys@7.0.0-rc13 \
      whatsapp-rust-bridge@0.5.4 \
    && node -e "const fs=require('fs'); const path=require('path'); for (const [name,expected] of [['baileys','7.0.0-rc13'],['whatsapp-rust-bridge','0.5.4']]) { const entry=require.resolve(name); let dir=path.dirname(entry); while (!fs.existsSync(path.join(dir,'package.json'))) { const parent=path.dirname(dir); if (parent===dir) throw new Error('package metadata not found: '+name); dir=parent; } const version=JSON.parse(fs.readFileSync(path.join(dir,'package.json'),'utf8')).version; if (version!==expected) throw new Error(name+' resolved to '+version); console.log(name+'@'+version); }"
