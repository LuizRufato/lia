+const REQUIRED_PREVIEW_HOST = 'go.botlia.com.br';
+const REQUIRED_PREVIEW_TIMEOUT_MS = 5_000;
+const REQUIRED_PREVIEW_MAX_BYTES = 2_000_000;
+const REQUIRED_PREVIEW_ERROR = 'LINK_PREVIEW_REQUIRED_UNAVAILABLE';
+
+const privatePreviewNetworks = new BlockList();
+const privatePreviewIpv4Subnets: Array<[string, number]> = [
+  ['0.0.0.0', 8],
+  ['10.0.0.0', 8],
+  ['100.64.0.0', 10],
+  ['127.0.0.0', 8],
+  ['169.254.0.0', 16],
+  ['172.16.0.0', 12],
+  ['192.0.0.0', 24],
+  ['192.0.2.0', 24],
+  ['192.168.0.0', 16],
+  ['198.18.0.0', 15],
+  ['198.51.100.0', 24],
+  ['203.0.113.0', 24],
+  ['224.0.0.0', 4],
+  ['240.0.0.0', 4],
+];
+privatePreviewIpv4Subnets.forEach(([address, prefix]) => privatePreviewNetworks.addSubnet(address, prefix, 'ipv4'));
+const privatePreviewIpv6Subnets: Array<[string, number]> = [
+  ['::', 128],
+  ['::1', 128],
+  ['fc00::', 7],
+  ['fe80::', 10],
+  ['ff00::', 8],
+  ['2001:db8::', 32],
+];
+privatePreviewIpv6Subnets.forEach(([address, prefix]) => privatePreviewNetworks.addSubnet(address, prefix, 'ipv6'));
+
+function isPrivatePreviewAddress(address: string) {
+  const mappedIpv4 = address.match(/^::ffff:(\d+\.\d+\.\d+\.\d+)$/i)?.[1];
+  const normalized = mappedIpv4 || address;
+  const family = isIP(normalized);
+  if (family === 4) return privatePreviewNetworks.check(normalized, 'ipv4');
+  if (family === 6) return privatePreviewNetworks.check(normalized, 'ipv6');
+  return true;
+}
+
+function previewFailure(reason: string) {
+  const error = new Error(REQUIRED_PREVIEW_ERROR);
+  (error as any).code = REQUIRED_PREVIEW_ERROR;
+  (error as any).previewReason = reason;
+  return error;
+}
