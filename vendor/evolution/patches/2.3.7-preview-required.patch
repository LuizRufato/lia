+  private async getRequiredLinkPreview(text: string): Promise<WAUrlInfo> {
+    try {
+      const matchedText = extractUrlFromText(text)?.replace(/[),.;!?]+$/g, '');
+      if (!matchedText) throw previewFailure('URL_MISSING');
+
+      let parsedUrl: URL;
+      try {
+        parsedUrl = new URL(matchedText);
+      } catch {
+        throw previewFailure('URL_INVALID');
+      }
+      if (parsedUrl.protocol !== 'https:' || parsedUrl.hostname !== REQUIRED_PREVIEW_HOST) {
+        throw previewFailure('HOST_NOT_ALLOWED');
+      }
+
+      const addresses = await lookup(parsedUrl.hostname, { all: true, verbatim: true });
+      if (!addresses.length || addresses.some(({ address }) => isPrivatePreviewAddress(address))) {
+        throw previewFailure('PRIVATE_ADDRESS');
+      }
+
+      const preview = await getUrlInfo(parsedUrl.toString(), {
+        thumbnailWidth: 192,
+        fetchOpts: {
+          timeout: REQUIRED_PREVIEW_TIMEOUT_MS,
+          maxContentLength: REQUIRED_PREVIEW_MAX_BYTES,
+        } as any,
+        uploadImage: this.client.waUploadToServer,
+      });
+      if (!preview || !preview.title?.trim() || !Buffer.isBuffer(preview.jpegThumbnail)) {
+        throw previewFailure('PREVIEW_METADATA_INCOMPLETE');
+      }
+      if (preview.jpegThumbnail.length === 0 || preview.jpegThumbnail.length > REQUIRED_PREVIEW_MAX_BYTES) {
+        throw previewFailure('THUMBNAIL_INVALID');
+      }
+
+      const canonicalUrl = new URL(preview['canonical-url']);
+      if (canonicalUrl.protocol !== 'https:' || canonicalUrl.hostname !== REQUIRED_PREVIEW_HOST) {
+        throw previewFailure('CANONICAL_HOST_NOT_ALLOWED');
+      }
+      if (!preview['matched-text']) throw previewFailure('MATCHED_URL_MISSING');
+
+      this.logger.info(
+        JSON.stringify({
+          event: 'PREVIEW_GATE_READY',
+          previewRequired: true,
+          hasTitle: true,
+          hasThumbnail: true,
+          thumbnailBytes: preview.jpegThumbnail.length,
+          providerSendStarted: false,
+        }),
+      );
+      return preview;
+    } catch (error) {
+      const reason = (error as any)?.previewReason || 'HELPER_FAILED';
+      this.logger.warn(
+        JSON.stringify({
+          event: 'PREVIEW_GATE_FAILED',
+          previewRequired: true,
+          reason,
+          providerSendStarted: false,
+        }),
+      );
+      if ((error as any)?.code === REQUIRED_PREVIEW_ERROR) throw error;
+      throw previewFailure(reason);
+    }
+  }
