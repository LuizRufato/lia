# Copy these values into Coolify's Environment Variables interface. Never
# commit a real .env file or paste production secrets into the repository.
POSTGRES_USER=lia
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=lia_db
DATABASE_URL=postgresql://lia:replace-with-a-url-safe-random-password@postgres:5432/lia_db?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
INTEGRATION_SECRET_KEY=replace-with-a-long-random-secret
CLICK_HASH_SECRET=replace-with-a-long-random-secret
EVOLUTION_POSTGRES_PASSWORD=replace-with-a-long-random-password
EVOLUTION_GLOBAL_API_KEY=replace-with-a-long-random-api-key

# Use the VPS IP only during initial staging. Replace all three with HTTPS
# domains before enabling real public tracked links or automatic publishing.
WEB_URL=http://YOUR_SERVER_IP:3001
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:3000
TRACKER_PUBLIC_BASE_URL=http://YOUR_SERVER_IP:3002
# Internal-only: do not expose Evolution directly to the internet.
EVOLUTION_PUBLIC_URL=http://evolution-api:8080

ADMIN_BOOTSTRAP_EMAIL=your-admin-email@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-unique-strong-password
