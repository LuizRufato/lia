# Variáveis do Ambiente (Estrutura Inicial)
# NUNCA insira valores reais aqui. Copie este arquivo para .env localmente.

# Autenticação
JWT_SECRET="SEGREDO_SUPER_SEGURO_PARA_O_JWT_COM_32_CARACTERES"

# Frontend — a porta 3000 pode estar ocupada na máquina local; a web roda
# na 6000 para teste local (troque de volta para 3001 se preferir).
# A 3000 nunca seria usada pela web: é a API.
WEB_URL="http://localhost:6000"
# Tracker (API em 3000, web em 6000, tracker em 6002 — sem colisão)
TRACKER_URL="http://localhost:6002"

# Banco de Dados
POSTGRES_USER="seu_usuario"
POSTGRES_PASSWORD="sua_senha_segura"
POSTGRES_DB="lia_db"
DATABASE_URL="postgresql://seu_usuario:sua_senha_segura@localhost:5432/lia_db?schema=public"

# Cache e Filas
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PREFIX="{lia}"
CLICK_HASH_SECRET="dev-only-click-hash-secret"

# WhatsApp Evolution (use valores locais exclusivos; nunca reutilize em produção)
EVOLUTION_POSTGRES_PASSWORD="uma_senha_local_segura"
EVOLUTION_GLOBAL_API_KEY="uma_chave_local_aleatoria"

# Integrações (A preencher nas próximas fases)
# TELEGRAM_BOT_TOKEN=
# SHOPEE_APP_ID=
# MERCADOLIVRE_CLIENT_ID=
# WHATSAPP_ACCESS_TOKEN=

# LIA Ads / Meta Marketing API (read-only foundation; leave empty until approved)
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:3000/ads/meta/callback
# META_GRAPH_API_VERSION=
# Required by WhatsAppCloudProvider (untouched, throws if missing).
# META_GRAPH_API_VERSION=v21.0
# Meta webhook signature verification (optional; when absent the POST is accepted).
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Criptografia de integrações — obrigatória (gerar com: openssl rand -hex 32)
# Token WhatsApp Cloud (cifrado com INTEGRATION_ENCRYPTION_KEY)
# NOTA: INTEGRATION_SECRET_KEY (legado) ainda é lido como fallback pelo
# WhatsAppCloudProvider — mantenha-o igual a esta chave se você o usar.
INTEGRATION_ENCRYPTION_KEY="64_hex_chars_here"
# INTEGRATION_SECRET_KEY="old:64_hex_chars_here"

WEB_URL=http://localhost:6000
NEXT_PUBLIC_API_URL=http://localhost:3000
# Required in production when Web and API use subdomains of the same parent domain.
# Keep empty for local development; production uses botlia.com.br.
AUTH_COOKIE_DOMAIN=
# URL pública do tracker (usada pelo healthcheck).
# TRACKER_URL=http://localhost:6002
