# Variáveis do Ambiente (Estrutura Inicial)
# NUNCA insira valores reais aqui. Copie este arquivo para .env localmente.

# Autenticação
JWT_SECRET="SEGREDO_SUPER_SEGURO_PARA_O_JWT_COM_32_CARACTERES"

# Frontend — a porta 3000 pode estar ocupada na máquina local; a web roda
# na 6000 para teste local (troque de volta para 3001 se preferir).
WEB_URL="http://localhost:6000"
# Tracker (API em 3000, web em 6000, tracker em 6002 — sem colisão)
TRACKER_URL="http://localhost:6002"

# Banco de Dados
POSTGRES_USER="seu_usuario"
POSTGRES_PASSWORD="sua_senha_segura"
POSTGRES_DB="lia_db"
DATABASE_URL="postgresql://seu_usuario:sua_senha_segura@localhost:5432/lia_db?schema=public"

# Cache e Filas
REDIS_URL="redis://localhost:6379"

# WhatsApp Evolution (use valores locais exclusivos; nunca reutilize em produção)
EVOLUTION_POSTGRES_PASSWORD="uma_senha_local_segura"
EVOLUTION_GLOBAL_API_KEY="uma_chave_local_aleatoria"

# Integrações (A preencher nas próximas fases)
# TELEGRAM_BOT_TOKEN=
# SHOPEE_APP_ID=
# MERCADOLIVRE_CLIENT_ID=
# WHATSAPP_ACCESS_TOKEN=

WEB_URL=http://localhost:6000
NEXT_PUBLIC_API_URL=http://localhost:3000
# URL pública do tracker (usada pelo healthcheck).
# TRACKER_URL=http://localhost:6002
