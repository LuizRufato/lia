# Variáveis do Ambiente (Estrutura Inicial)
# NUNCA insira valores reais aqui. Copie este arquivo para .env localmente.

# Banco de Dados
POSTGRES_USER="seu_usuario"
POSTGRES_PASSWORD="sua_senha_segura"
POSTGRES_DB="lia_db"
DATABASE_URL="postgresql://seu_usuario:sua_senha_segura@localhost:5432/lia_db?schema=public"

# Cache e Filas
REDIS_URL="redis://localhost:6379"

